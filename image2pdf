#!/bin/bash
# Convert image to A4 sized pdf
# Afterwards join with:
# pdftk file1.pdf file2.pdf file3.pdf cat output outputfile.pdf flatten
# or similar

for var in "$@"; do
	echo "Processing: $var"
	magick "$var" \
		-resize 2480x3508 \
		-gravity center \
		-background white \
		-extent 2480x3508 \
		-density 300 \
		"${var%.*}".pdf
done
